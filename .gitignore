# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# ESP-IDF / CMake 误用产生的目录
build/
sdkconfig*
*.bin
# 发行包固件必须入库: 否则打 tag/发 Release 时 firmware/ 里没有可烧录文件
!firmware/*.bin
*.elf
*.hex
*.map

# 本地生成的编译数据库(含本机绝对路径, 可用 `pio run -t compiledb` 重新生成)
compile_commands.json

# 构建/调试日志
*.log

# 系统/编辑器
.DS_Store
Thumbs.db
*.swp
*.bak

# 本机编辑器配置(含绝对路径); 仅保留共享的 c_cpp_properties.json
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.workbuddy/
